# Copiar a .env en el servidor y rellenar. Nunca subir .env a git.
GITHUB_OWNER=tu-usuario-de-github
API_TAG=latest
WEB_TAG=latest

POSTGRES_DB=albumviajes
POSTGRES_USER=albumviajes
POSTGRES_PASSWORD=cambia-esta-clave

# URL publica del sitio, la que sirve el reverse proxy con TLS.
PUBLIC_URL=https://viajes.tu-dominio.com

# Solo el host, sin esquema: es lo que va en la regla Host(...) de Traefik.
# El flujo de despliegue lo deriva de PUBLIC_URL, no hace falta un secreto.
PUBLIC_HOST=viajes.tu-dominio.com

# Wikipedia y Wikidata exigen un User-Agent que identifique la aplicacion y de
# un contacto: sin el devuelven 403.
WIKIMEDIA_USER_AGENT=AlbumViajes/1.0 (https://viajes.tu-dominio.com; tu-correo@ejemplo.com)
WIKIPEDIA_LANGUAGE=es

# Radio Browser pide lo mismo para poder contactar a quien abuse de su API.
RADIO_USER_AGENT=AlbumViajes/1.0 (https://viajes.tu-dominio.com; tu-correo@ejemplo.com)

# Pais del catalogo de canciones (iTunes), en ISO 3166-1 alfa-2. Decide que
# canciones se ven y cuales estan disponibles. El buscador no necesita clave.
MUSIC_LIBRARY_COUNTRY=CO

# Unico correo que puede editar el album. Cualquier otro que entre con Google
# es rechazado; para ver el album no hace falta entrar.
OWNER_EMAIL=tu-correo@gmail.com

# Credenciales de la aplicacion en Google Cloud, con la Photos Picker API
# habilitada. El URI de redireccion autorizado debe ser exactamente:
#   https://viajes.tu-dominio.com/api/auth/google/callback
# Sin estos valores el album funciona entero salvo importar fotos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ajustes de la importacion de fotos. Los valores por defecto sirven para un
# album normal; subirlos solo hace falta con originales muy grandes.
GOOGLE_PHOTOS_TIMEOUT_SECONDS=120
GOOGLE_PHOTOS_MAX_BYTES=31457280
GOOGLE_PHOTOS_POLL_SECONDS=5
PHOTO_THUMBNAIL_WIDTH=480
