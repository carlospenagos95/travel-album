{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "AllowedEmails": [],
    "PostLoginRedirect": "/",
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "PhotoStorage": {
    "RootPath": "/data/photos",
    "ThumbnailWidth": 480
  },
  "GooglePhotos": {
    "PickerBaseUrl": "https://photospicker.googleapis.com/v1",
    "TokenEndpoint": "https://oauth2.googleapis.com/token",
    "TimeoutSeconds": 120,
    "MaxPhotoBytes": 31457280,
    "DefaultPollIntervalSeconds": 5
  },
  "Music": {
    "DirectoryBaseUrl": "https://all.api.radio-browser.info",
    "UserAgent": "AlbumViajes/1.0 (https://github.com/album-viajes)",
    "SearchTimeoutSeconds": 10,
    "SearchCacheMinutes": 30,
    "StreamTimeoutSeconds": 20
  },
  "Enrichment": {
    "WikipediaLanguage": "es",
    "UserAgent": "AlbumViajes/1.0 (https://github.com/album-viajes)",
    "SearchRadiusMeters": 10000,
    "TimeoutSeconds": 15
  }
}
