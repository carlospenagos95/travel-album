root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,slnx}]
indent_size = 2

[*.cs]
# Usings
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Namespaces sin llaves
csharp_style_namespace_declarations = file_scoped:warning

# Modificadores explicitos
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:warning

# Inmutabilidad
dotnet_style_readonly_field = true:warning
csharp_prefer_readonly_struct = true:warning

# var solo cuando el tipo es evidente
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expresiones modernas
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion

# Llaves siempre, incluso en una linea
csharp_prefer_braces = true:warning

# Nombres
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# Reglas que atrapan bugs reales
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1848.severity = none
# Misma familia que CA1848: los argumentos que se registran aqui son un entero o
# una URL ya construida, no calculos que valga la pena evitar con una guarda.
dotnet_diagnostic.CA1873.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA2016.severity = warning
dotnet_diagnostic.CA1062.severity = none
# Interop con otros lenguajes .NET: no aplica, la API solo se consume desde C#
dotnet_diagnostic.CA1716.severity = none
# Result<T>.Success/Failure son el patron idiomatico de este tipo
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.IDE0055.severity = suggestion

[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# Las migraciones las escribe EF Core, no nosotros: no tiene sentido exigirles
# nuestro estilo ni bloquear el build por ellas.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.CA1861.severity = none
